{
  "name": "vue3-mastery-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test mini-vue/test/*.test.mjs && node scripts/verify.mjs",
    "mini:demo": "node mini-vue/demo.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.5.1",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "highlight.js": "^11.11.1",
    "@vue/compiler-dom": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vue-tsc": "^3.3.11"
  }
}
