{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "strict": true, "isolatedModules": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "jsx": "preserve",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "vite.config.ts"]
}
